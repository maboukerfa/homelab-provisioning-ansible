# Template. The real file lives only on the host at /opt/silverbullet/.env
# (root:root, 0640) and is gitignored -- nothing in this repo deploys this one.
#
# SB_USER is the only credential on the instance. Format is user:password, e.g.
#   SB_USER=silverbullet:s0me-long-passphrase
#
# Left empty on purpose. compose.yaml reads it as ${SB_USER:?...}, and the `:?`
# form errors on empty as well as unset -- so copying this file verbatim stops
# the stack with a clear message instead of quietly starting SilverBullet on a
# placeholder password that is published in this repo.
SB_USER=
